# >>> dev gitignore >>>
# Generated by `dev gitignore`. Edit outside this block, or re-run to update.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors and IDEs
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
.nvimlog
.null-ls_*

# Ephemeral coding-agent state
.claude/worktrees/
.claude/settings.local.json
