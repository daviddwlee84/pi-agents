.cursor/rules/_generated/

# Local environment and secrets — never commit real values
.env
.env.*
!.env.example
!.env.template
*.local
.direnv/
# <<< dev gitignore <<<

# Node development artifacts (the shipped CLI has no runtime dependencies)
node_modules/
coverage/

# MkDocs development and build artifacts
/.venv/
/site/

# Python test and bytecode caches
__pycache__/
*.py[cod]
.pytest_cache/
